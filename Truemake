	if state.bigHitbox then
		applyBigHitboxes()
	end
	if state.noCooldown then
		applyNoCooldown()
	end
	if state.godMode then
		applyGodMode()
	end
	if state.bypassPending then
		bypassClickPending()
	end
	if state.clickAll then
		local activeCount = interactEntireFolder()
		StatusLabel.Text = string.format("Folder: %d active", activeCount)
	end
end)

task.spawn(function()
	while ScreenGui.Parent do
		if not state.clickAll then
			cleanupSkips()
			local folder = getSpawnedFolder()
			local count = 0
			if folder then
				for _, child in ipairs(folder:GetChildren()) do
					if isObjAvailable(child) then
						count += 1
					end
				end
			end
			StatusLabel.Text = string.format("Folder: %d active", count)
		end
		task.wait(0.5)
	end
end)
