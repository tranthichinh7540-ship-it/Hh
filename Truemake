RunService.Heartbeat:Connect(function()
	local target = getActiveTarget()

	if state.selectedTarget and not isTargetClickable(state.selectedTarget) then
		state.selectedTarget = nil
		target = getActiveTarget()
	end

	if state.burstClick and target and target.Instance then
		triggerBurstBatch(target)

		local sig = sampleTargetState(target.Instance)
		local now = os.clock()
		if sig ~= state.lastHealthOrState then
			state.lastHealthOrState = sig
			state.lastProgressClock = now
		elseif (now - state.lastProgressClock) >= state.skipCooldown then
			markTargetUnclickable(target.Instance)
			state.lastProgressClock = now
			getActiveTarget()
		end
	end
end)

