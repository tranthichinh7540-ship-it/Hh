local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local state = {
	clickAll = false,
	bigHitbox = false,
	noCooldown = false,
	godMode = false,
	bypassPending = false,
	hitboxScale = 24,
	skipCooldown = 0.5,
	skippedInstances = {},
	lastStateSig = {},
	lastChangeClock = {},
	pendingHooks = {}, -- [Instance] = true
}

local expandedParts = {}
local savedCooldowns = {} -- [Instance] = { prop = value }

local function getSpawnedFolder()
	return Workspace:FindFirstChild("SpawnedSans")
end

local function getTargetPart(obj)
	if not obj or not obj.Parent then return nil end
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart
			or obj:FindFirstChild("HumanoidRootPart")
			or obj:FindFirstChild("Torso")
			or obj:FindFirstChild("UpperTorso")
			or obj:FindFirstChild("Head")
			or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

-- Skill No CD: quét và xóa/đưa về 0 các giá trị/thuộc tính/attribute liên quan cooldown
local function applyNoCooldown()
	if not state.noCooldown then return end

	local containers = {
		LocalPlayer,
		LocalPlayer.Character,
		LocalPlayer:FindFirstChild("Backpack"),
		PlayerGui,
	}

	local function cleanContainer(root)
		if not root then return end
		for _, inst in ipairs(root:GetDescendants()) do
			local lname = string.lower(inst.Name)
			if string.find(lname, "cooldown") or string.find(lname, "cd") or string.find(lname, "debounce") then
				if inst:IsA("NumberValue") or inst:IsA("IntValue") then
					if savedCooldowns[inst] == nil then
						savedCooldowns[inst] = inst.Value
					end
					inst.Value = 0
				elseif inst:IsA("BoolValue") then
					if savedCooldowns[inst] == nil then
						savedCooldowns[inst] = inst.Value
					end
					inst.Value = false
				end
			end

			for attrName, attrVal in pairs(inst:GetAttributes()) do
				local lattr = string.lower(attrName)
				if (string.find(lattr, "cooldown") or string.find(lattr, "cd") or string.find(lattr, "debounce")) and typeof(attrVal) == "number" then
					if savedCooldowns[inst] == nil then
						savedCooldowns[inst] = {}
					end
					if savedCooldowns[inst][attrName] == nil then
						savedCooldowns[inst][attrName] = attrVal
					end
					inst:SetAttribute(attrName, 0)
				end
			end
		end
	end

	for _, c in ipairs(containers) do
		pcall(cleanContainer, c)
	end
end

local function restoreCooldowns()
	for inst, oldVal in pairs(savedCooldowns) do
		if inst and inst.Parent then
			pcall(function()
				if typeof(oldVal) == "table" then
					for attrName, val in pairs(oldVal) do
						inst:SetAttribute(attrName, val)
					end
				elseif inst:IsA("NumberValue") or inst:IsA("IntValue") or inst:IsA("BoolValue") then
					inst.Value = oldVal
				end
			end)
		end
		savedCooldowns[inst] = nil
	end
end

-- Godmode client-side: giữ máu, chặn trạng thái chết/ragdoll/ngã
local function applyGodMode()
	if not state.godMode then return end
	local char = LocalPlayer.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			if hum.MaxHealth > 0 and hum.Health < hum.MaxHealth then
				hum.Health = hum.MaxHealth
			end
			hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		end)
	end
end

-- Bypass ClickPending: reset/tắt trạng thái đang chờ click hoặc mở khóa ngay khi bị kẹt pending
local function bypassClickPending()
	if not state.bypassPending then return end

	local function patchPending(inst)
		if not inst or not inst.Parent then return end
		local lname = string.lower(inst.Name)
		if string.find(lname, "clickpending") or string.find(lname, "pending") or string.find(lname, "isclicking") or string.find(lname, "debounce") then
			if inst:IsA("BoolValue") then
				inst.Value = false
			elseif inst:IsA("NumberValue") or inst:IsA("IntValue") then
				inst.Value = 0
			end
		end

		for attrName, attrVal in pairs(inst:GetAttributes()) do
			local lattr = string.lower(attrName)
			if string.find(lattr, "pending") or string.find(lattr, "clicking") then
				if typeof(attrVal) == "boolean" then
					inst:SetAttribute(attrName, false)
				elseif typeof(attrVal) == "number" then
					inst:SetAttribute(attrName, 0)
				end
			end
		end

		if not state.pendingHooks[inst] then
			state.pendingHooks[inst] = true
			if inst:IsA("BoolValue") then
				inst:GetPropertyChangedSignal("Value"):Connect(function()
					if state.bypassPending and inst.Value == true then
						inst.Value = false
					end
				end)
			elseif inst:IsA("NumberValue") or inst:IsA("IntValue") then
				inst:GetPropertyChangedSignal("Value"):Connect(function()
					if state.bypassPending and inst.Value ~= 0 then
						inst.Value = 0
					end
				end)
			end
		end
	end

	local roots = { LocalPlayer, LocalPlayer.Character, PlayerGui, getSpawnedFolder() }
	for _, r in ipairs(roots) do
		if r then
			for _, d in ipairs(r:GetDescendants()) do
				pcall(patchPending, d)
			end
		end
	end
end

local function cleanupSkips()
	local now = os.clock()
	for inst, untilClock in pairs(state.skippedInstances) do
		if not inst or not inst.Parent or now >= untilClock then
			state.skippedInstances[inst] = nil
		end
	end
	for inst in pairs(state.lastStateSig) do
		if not inst or not inst.Parent then
			state.lastStateSig[inst] = nil
			state.lastChangeClock[inst] = nil
		end
	end
end

local function markSkipped(obj)
	if obj then
		state.skippedInstances[obj] = os.clock() + state.skipCooldown
	end
end

local function isObjAvailable(obj)
	if not obj or not obj.Parent or not obj:IsDescendantOf(Workspace) then
		return false
	end

	local now = os.clock()
	local skipUntil = state.skippedInstances[obj]
	if skipUntil and now < skipUntil then
		return false
	end

	local hum = obj:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		return false
	end

	for _, desc in ipairs(obj:GetDescendants()) do
		if desc:IsA("ClickDetector") and desc.MaxActivationDistance <= 0 then
			return false
		elseif desc:IsA("ProximityPrompt") and not desc.Enabled then
			return false
		end
	end

	return true
end

local function sampleObjSig(obj)
	if not obj or not obj.Parent then return nil end
	local hum = obj:FindFirstChildOfClass("Humanoid")
	local hp = hum and hum.Health or 0
	return string.format("%.2f_%d", hp, #obj:GetDescendants())
end

local function restoreHitboxes()
	for part, saved in pairs(expandedParts) do
		if part and part.Parent then
			pcall(function()
				part.Size = saved.Size
				part.Transparency = saved.Transparency
				part.CanCollide = saved.CanCollide
				part.Massless = saved.Massless
			end)
		end
		expandedParts[part] = nil
	end
end

local function applyBigHitboxes()
	local folder = getSpawnedFolder()
	if not folder then return end

	local activeSet = {}
	for _, child in ipairs(folder:GetChildren()) do
		local part = getTargetPart(child)
		if part and part:IsA("BasePart") then
			activeSet[part] = true
			if not expandedParts[part] then
				expandedParts[part] = {
					Size = part.Size,
					Transparency = part.Transparency,
					CanCollide = part.CanCollide,
					Massless = part.Massless,
				}
			end
			pcall(function()
				part.Size = Vector3.new(state.hitboxScale, state.hitboxScale, state.hitboxScale)
				part.Transparency = math.max(expandedParts[part].Transparency, 0.75)
				part.CanCollide = false
				part.Massless = true
			end)
		end
	end

	for part, saved in pairs(expandedParts) do
		if not activeSet[part] then
			if part and part.Parent then
				pcall(function()
					part.Size = saved.Size
					part.Transparency = saved.Transparency
					part.CanCollide = saved.CanCollide
					part.Massless = saved.Massless
				end)
			end
			expandedParts[part] = nil
		end
	end
end

local function interactEntireFolder()
	cleanupSkips()
	local folder = getSpawnedFolder()
	if not folder then return 0 end

	if state.bypassPending then
		bypassClickPending()
	end

	local char = LocalPlayer.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then
		pcall(function()
			tool:Activate()
		end)
	end

	local now = os.clock()
	local count = 0

	for _, child in ipairs(folder:GetChildren()) do
		if isObjAvailable(child) then
			count += 1
			local interacted = false

			for _, desc in ipairs(child:GetDescendants()) do
				if desc:IsA("ClickDetector") then
					if desc.MaxActivationDistance <= 0 then
						markSkipped(child)
						interacted = false
						break
					end
					interacted = true
					pcall(function()
						if fireclickdetector then
							fireclickdetector(desc)
						end
					end)
				elseif desc:IsA("ProximityPrompt") then
					if not desc.Enabled then
						markSkipped(child)
						interacted = false
						break
					end
					interacted = true
					pcall(function()
						if fireproximityprompt then
							fireproximityprompt(desc)
						else
							desc:InputHoldBegin()
							desc:InputHoldEnd()
						end
					end)
				end
			end

			if interacted then
				local sig = sampleObjSig(child)
				if state.lastStateSig[child] ~= sig then
					state.lastStateSig[child] = sig
					state.lastChangeClock[child] = now
				elseif state.lastChangeClock[child] and (now - state.lastChangeClock[child]) >= state.skipCooldown then
					markSkipped(child)
					state.lastChangeClock[child] = now
				end
			end
		end
	end

	return count
end

