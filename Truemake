local state = {
	followTarget = false,
	burstClick = false,
	bigHitbox = false,
	hitboxScale = 22,
	followOffset = Vector3.new(0, 0, 3.5),
	selectedTarget = nil,
	skippedTargets = {}, -- [Instance] = os.clock()
	skipCooldown = 0.5,  -- Bỏ qua sau 0.5s nếu không click/tiến triển được
	lastProgressClock = 0,
	lastHealthOrState = nil,
}

local expandedParts = {}

local function getCharacter()
	return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getCharacterRoot()
	local char = getCharacter()
	return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
end

local function getSpawnedFolder()
	return Workspace:FindFirstChild("SpawnedSans")
end

local function getTargetPart(obj)
	if not obj or not obj.Parent then return nil end
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart
			or obj:FindFirstChild("HumanoidRootPart")
			or obj:FindFirstChild("Torso")
			or obj:FindFirstChild("UpperTorso")
			or obj:FindFirstChild("Head")
			or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function isTargetClickable(obj)
	if not obj or not obj.Parent or not obj:IsDescendantOf(Workspace) then
		return false
	end

	local now = os.clock()
	local skipUntil = state.skippedTargets[obj]
	if skipUntil and now < skipUntil then
		return false
	end

	local hum = obj:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		return false
	end

	local part = getTargetPart(obj)
	if not part or not part.Parent then
		return false
	end

	for _, desc in ipairs(obj:GetDescendants()) do
		if desc:IsA("ClickDetector") and desc.MaxActivationDistance <= 0 then
			return false
		elseif desc:IsA("ProximityPrompt") and not desc.Enabled then
			return false
		end
	end

	return true
end

local function cleanupExpiredSkips()
	local now = os.clock()
	for inst, expiry in pairs(state.skippedTargets) do
		if not inst or not inst.Parent or now >= expiry then
			state.skippedTargets[inst] = nil
		end
	end
end

local function markTargetUnclickable(obj)
	if obj then
		state.skippedTargets[obj] = os.clock() + state.skipCooldown
		if state.selectedTarget == obj then
			state.selectedTarget = nil
		end
	end
end

local function sampleTargetState(obj)
	if not obj or not obj.Parent then return nil end
	local hum = obj:FindFirstChildOfClass("Humanoid")
	local hp = hum and hum.Health or 0
	local descCount = #obj:GetDescendants()
	return string.format("%.2f_%d", hp, descCount)
end

local function getAllSansTargets()
	cleanupExpiredSkips()
	local folder = getSpawnedFolder()
	local list = {}
	if not folder then return list end

	local root = getCharacterRoot()
	for _, child in ipairs(folder:GetChildren()) do
		if isTargetClickable(child) then
			local part = getTargetPart(child)
			if part then
				local dist = root and (root.Position - part.Position).Magnitude or math.huge
				table.insert(list, {
					Instance = child,
					Part = part,
					Name = child.Name,
					Distance = dist,
				})
			end
		end
	end

	table.sort(list, function(a, b)
		if a.Distance ~= b.Distance then
			return a.Distance < b.Distance
		end
		return a.Name < b.Name
	end)

	return list
end

local function getActiveTarget()
	if state.selectedTarget and isTargetClickable(state.selectedTarget) then
		local part = getTargetPart(state.selectedTarget)
		if part then
			local root = getCharacterRoot()
			local dist = root and (root.Position - part.Position).Magnitude or math.huge
			return {
				Instance = state.selectedTarget,
				Part = part,
				Name = state.selectedTarget.Name,
				Distance = dist,
			}
		end
	end

	local targets = getAllSansTargets()
	if targets[1] then
		if state.selectedTarget ~= targets[1].Instance then
			state.selectedTarget = targets[1].Instance
			state.lastProgressClock = os.clock()
			state.lastHealthOrState = sampleTargetState(targets[1].Instance)
		end
		return targets[1]
	end

	state.selectedTarget = nil
	return nil
end

local function restoreHitboxes()
	for part, saved in pairs(expandedParts) do
		if part and part.Parent then
			pcall(function()
				part.Size = saved.Size
				part.Transparency = saved.Transparency
				part.CanCollide = saved.CanCollide
				part.Massless = saved.Massless
			end)
		end
		expandedParts[part] = nil
	end
end

local function applyBigHitboxes()
	local folder = getSpawnedFolder()
	if not folder then return end

	local activeSet = {}
	for _, child in ipairs(folder:GetChildren()) do
		local part = getTargetPart(child)
		if part and part:IsA("BasePart") then
			activeSet[part] = true
			if not expandedParts[part] then
				expandedParts[part] = {
					Size = part.Size,
					Transparency = part.Transparency,
					CanCollide = part.CanCollide,
					Massless = part.Massless,
				}
			end
			pcall(function()
				part.Size = Vector3.new(state.hitboxScale, state.hitboxScale, state.hitboxScale)
				part.Transparency = math.max(expandedParts[part].Transparency, 0.75)
				part.CanCollide = false
				part.Massless = true
			end)
		end
	end

	for part, saved in pairs(expandedParts) do
		if not activeSet[part] then
			if part and part.Parent then
				pcall(function()
					part.Size = saved.Size
					part.Transparency = saved.Transparency
					part.CanCollide = saved.CanCollide
					part.Massless = saved.Massless
				end)
			end
			expandedParts[part] = nil
		end
	end
end

RunService.Heartbeat:Connect(function()
	if state.bigHitbox then
		applyBigHitboxes()
	end

	if not state.followTarget then return end
	local target = getActiveTarget()
	if not target or not target.Part or not target.Part.Parent then return end

	local root = getCharacterRoot()
	if not root then return end

	local desiredPos = (target.Part.CFrame * CFrame.new(state.followOffset)).Position
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.lookAt(desiredPos, target.Part.Position)
end)

local function triggerBurstBatch(primaryTarget)
	local char = LocalPlayer.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then
		pcall(function()
			tool:Activate()
		end)
	end

	local folder = getSpawnedFolder()
	if not folder then return end

	local root = getCharacterRoot()
	local reachRadius = state.bigHitbox and (state.hitboxScale * 0.85) or 14

	local function interactWithObj(obj)
		if not obj or not obj.Parent then return end
		for _, desc in ipairs(obj:GetDescendants()) do
			if desc:IsA("ClickDetector") then
				if desc.MaxActivationDistance <= 0 then
					markTargetUnclickable(obj)
				else
					pcall(function()
						if fireclickdetector then
							fireclickdetector(desc)
						end
					end)
				end
			elseif desc:IsA("ProximityPrompt") then
				if not desc.Enabled then
					markTargetUnclickable(obj)
				else
					pcall(function()
						if fireproximityprompt then
							fireproximityprompt(desc)
						else
							desc:InputHoldBegin()
							desc:InputHoldEnd()
						end
					end)
				end
			end
		end
	end

	if primaryTarget and primaryTarget.Instance then
		interactWithObj(primaryTarget.Instance)
	end

	for _, child in ipairs(folder:GetChildren()) do
		if child ~= (primaryTarget and primaryTarget.Instance) and isTargetClickable(child) then
			local p = getTargetPart(child)
			if p and root and (root.Position - p.Position).Magnitude <= reachRadius then
				interactWithObj(child)
			end
		end
	end
end

