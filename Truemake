local function makeToggle(labelText, yPos)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 30)
	btn.Position = UDim2.fromOffset(10, yPos)
	btn.BackgroundColor3 = Color3.fromRGB(24, 24, 29)
	btn.Text = labelText .. " · OFF"
	btn.TextColor3 = Color3.fromRGB(205, 208, 218)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 11
	btn.Parent = MainFrame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(42, 42, 50)
	stroke.Thickness = 1
	stroke.Parent = btn

	return btn, stroke
end

