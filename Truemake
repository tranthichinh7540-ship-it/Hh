local function styleToggle(btn, stroke, title, active)
	btn.Text = title .. (active and " · ON" or " · OFF")
	btn.BackgroundColor3 = active and Color3.fromRGB(22, 68, 46) or Color3.fromRGB(24, 24, 29)
	btn.TextColor3 = active and Color3.fromRGB(145, 255, 190) or Color3.fromRGB(205, 208, 218)
	stroke.Color = active and Color3.fromRGB(48, 150, 98) or Color3.fromRGB(42, 42, 50)
end

local function refreshList()
	for _, child in ipairs(ScrollList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local targets = getAllSansTargets()
	local active = getActiveTarget()
	local tLabel = active and string.format("%s (%.0fm)", active.Name, active.Distance) or "None"
	InfoBar.Text = string.format("Active: %d | Target: %s", #targets, tLabel)

	for i, item in ipairs(targets) do
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, 25)
		row.LayoutOrder = i
		local selected = (state.selectedTarget == item.Instance)
		row.BackgroundColor3 = selected and Color3.fromRGB(42, 54, 84) or Color3.fromRGB(27, 27, 33)
		row.Text = string.format("%d. %s  ·  %.0f", i, item.Name, item.Distance)
		row.TextColor3 = selected and Color3.fromRGB(210, 230, 255) or Color3.fromRGB(220, 222, 230)
		row.Font = Enum.Font.GothamMedium
		row.TextSize = 11
		row.TextTruncate = Enum.TextTruncate.AtEnd
		row.Parent = ScrollList
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

		row.MouseButton1Click:Connect(function()
			state.selectedTarget = item.Instance
			state.lastProgressClock = os.clock()
			state.lastHealthOrState = sampleTargetState(item.Instance)
			refreshList()
		end)
	end

	task.wait()
	ScrollList.CanvasSize = UDim2.fromOffset(0, Layout.AbsoluteContentSize.Y + 10)
end

