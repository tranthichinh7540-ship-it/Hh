local function setToggleState(btn, stroke, title, active)
	btn.Text = title .. (active and " · ON" or " · OFF")
	btn.BackgroundColor3 = active and Color3.fromRGB(22, 68, 46) or Color3.fromRGB(24, 24, 29)
	btn.TextColor3 = active and Color3.fromRGB(145, 255, 190) or Color3.fromRGB(205, 208, 218)
	stroke.Color = active and Color3.fromRGB(48, 150, 98) or Color3.fromRGB(42, 42, 50)
end

ClickAllBtn.MouseButton1Click:Connect(function()
	state.clickAll = not state.clickAll
	setToggleState(ClickAllBtn, ClickAllStroke, "Click Toàn Bộ Folder", state.clickAll)
	if state.clickAll then
		local now = os.clock()
		local folder = getSpawnedFolder()
		if folder then
			for _, child in ipairs(folder:GetChildren()) do
				state.lastStateSig[child] = sampleObjSig(child)
				state.lastChangeClock[child] = now
			end
		end
	end
end)

